<?xml version="1.0" encoding="UTF-8"?>
<VariablesViewState
   version = "1.0">
   <ContextStates>
      <ContextState
         contextName = "TrackersListViewController.refreshViewForDate(date:):TrackersListViewController.swift">
         <PersistentStrings>
            <PersistentString
               value = "filteredTrackers">
            </PersistentString>
            <PersistentString
               value = "categories[safe: 0]">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
      <ContextState
         contextName = "TrackersListViewController.collectionView(_:cellForItemAt:):TrackersListViewController.swift">
         <PersistentStrings>
            <PersistentString
               value = "filteredTrackers">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
      <ContextState
         contextName = "NewHabitController.textField(_:shouldChangeCharactersIn:replacementString:):NewHabitController.swift">
         <PersistentStrings>
            <PersistentString
               value = "chosenDays.isEmpty">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
      <ContextState
         contextName = "main:AppDelegate.swift">
      </ContextState>
      <ContextState
         contextName = "TrackersListViewController.didCreateNewHabit(record:):TrackersListViewController.swift">
         <PersistentStrings>
            <PersistentString
               value = "categories">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
   </ContextStates>
</VariablesViewState>
